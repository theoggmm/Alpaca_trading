# Copier ce fichier en ".env" puis coller vos clés (Alpaca > Paper Trading > API Keys)
ALPACA_API_KEY=VOTRE_CLE_API
ALPACA_SECRET_KEY=VOTRE_CLE_SECRETE

# true = paper trading (argent virtuel). Mettre false UNIQUEMENT pour le compte réel.
ALPACA_PAPER=true

# Contact exigé par la SEC pour lire les domaines d'activité (nom puis e-mail), par exemple :
# SEC_USER_AGENT=Prénom Nom prenom.nom@example.com
SEC_USER_AGENT=
